{
  "expo": {
    "name": "Kira",
    "slug": "kira",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kira",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kira.app"
    },
    "android": {
      "package": "com.kira.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0075de"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0075de"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
